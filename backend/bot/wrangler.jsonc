{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sticker-bridge-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable for /healthz, and /run + /debug with the bot secret.
  "workers_dev": true,
  "browser": { "binding": "BROWSER" },
  "services": [{ "binding": "API", "service": "sticker-bridge-api" }],
  "kv_namespaces": [{ "binding": "STATE", "id": "296c138399f0420d9f79d64516f1fb7c" }],
  "vars": {
    "MAX_CHATS": "10",
    "SEND_REPLIES": "false",
    "INBOX_URL": "https://www.tiktok.com/messages?lang=en"
  },
  // Backup only: the live bot runs on Render (backend/bot/Dockerfile). No schedule here, so only one
  // session uses the @stickerbridge account. Run a pass by hand with POST /run if Render is down.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
  // Secrets: BOT_SECRET (same as the API's). Optional TIKTOK_COOKIES (first-time login).
}
