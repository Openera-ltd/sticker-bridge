{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sticker-bridge-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Only reachable for manual test runs (POST /run with the bot secret).
  "workers_dev": true,
  "browser": { "binding": "BROWSER" },
  "services": [{ "binding": "API", "service": "sticker-bridge-api" }],
  "vars": { "MAX_CHATS": "10", "SEND_REPLIES": "false" },
  // How often the inbox is read. Cloudflare's free plan allows 10 browser-minutes a day,
  // so every 30 minutes is the safe default. Faster needs the Workers Paid plan.
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
  // Secrets: BOT_SECRET (same as the API's), TIKTOK_COOKIES (@stickerbridge login)
}
