<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The app additionally refuses any host other than the API base (see ApiGuard). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
